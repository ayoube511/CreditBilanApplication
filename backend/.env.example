# ============================================================
# Plateforme Crédit / Bilan - Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS commiter le fichier .env dans Git !
# ============================================================

# MySQL local (XAMPP)
MYSQL_USER=root
MYSQL_PASSWORD=

# MinIO Docker
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=credit-bilan-documents

# JWT (changer en production !)
JWT_SECRET=credit-bilan-super-secret-key-change-this-in-production-minimum-256-bits

# LLM (optionnel - Semaine 3)
# LLM_API_KEY=your-api-key-here
# LLM_BASE_URL=https://api.anthropic.com
